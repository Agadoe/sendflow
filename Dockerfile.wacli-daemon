FROM node:20-bookworm

RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    && wget -q -O /tmp/chrome.deb https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_131.0.6778.85-1_amd64.deb \
    && apt-get install -y /tmp/chrome.deb \
    && rm /tmp/chrome.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install whatsapp-web.js and qrcode-terminal
COPY package*.json ./
RUN npm install --production

COPY wacli-daemon.js ./

# Create auth directory
RUN mkdir -p /root/.wacli_auth

EXPOSE 4555

CMD ["node", "wacli-daemon.js"]