[Unit]
Description=SendFlow WhatsApp Daemon v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/node /home/ubuntu/wacli-daemon-v2.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/wacli-daemon-v2.log
StandardError=append:/home/ubuntu/wacli-daemon-v2-error.log
Environment=WACLI_PORT=4555

[Install]
WantedBy=multi-user.target